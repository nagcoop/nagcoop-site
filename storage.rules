rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Pasta de downloads: leitura pública; upload só por admin
    match /downloads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/(default)/documents/admins/$(request.auth.uid)).data != null;
    }

    // Bloqueia escrita no resto do bucket
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
